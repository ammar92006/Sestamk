<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         هوية سيستمك البصرية (Brand Identity)
         اللون الأساسي: أخضر زمردي / تركواز عصري
         ============================================================ -->

    <!-- Brand accent gradient -->
    <Color x:Key="BrandPrimaryColor">#10B981</Color>
    <Color x:Key="BrandPrimaryDarkColor">#059669</Color>
    <Color x:Key="BrandSecondaryColor">#0EA5E9</Color>
    <Color x:Key="BrandDangerColor">#EF4444</Color>
    <Color x:Key="BrandWarningColor">#F59E0B</Color>
    <Color x:Key="BrandSuccessColor">#22C55E</Color>
    <Color x:Key="BrandMutedColor">#94A3B8</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="{StaticResource BrandDangerColor}" />
    <SolidColorBrush x:Key="BrandWarningBrush" Color="{StaticResource BrandWarningColor}" />
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="{StaticResource BrandSuccessColor}" />
    <SolidColorBrush x:Key="BrandMutedBrush" Color="{StaticResource BrandMutedColor}" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F766E" Offset="0" />
        <GradientStop Color="#0B1120" Offset="1" />
    </LinearGradientBrush>

    <!-- Surface / card backgrounds -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B2333" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3447" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1120" />

    <!-- Default Arabic-friendly font -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <!-- Reusable card style -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Section title -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrandMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>
