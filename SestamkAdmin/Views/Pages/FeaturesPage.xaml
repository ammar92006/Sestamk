<Page x:Class="SestamkAdmin.Views.Pages.FeaturesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="المميزات">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Apps24" FontSize="26"
                               Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="المميزات" FontSize="26" FontWeight="Bold"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="تشغيل وإطفاء مميزات البرنامج لكل شركة — مجمّعة حسب القسم"
                       Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="الشركة:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbCompany" Width="280" DisplayMemberPath="Display"
                      Padding="10,8" SelectionChanged="Company_Changed"/>
            <Border x:Name="planBadge" CornerRadius="8" Padding="10,4" Margin="12,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="planText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="22" Height="22"
                             Margin="14,0,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl x:Name="groupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <!-- عنوان الكاتيجوري -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="4" CornerRadius="2" Background="{StaticResource BrandPrimaryBrush}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Category}" FontSize="15"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- مميزات الكاتيجوري -->
                                    <ItemsControl ItemsSource="{Binding Features}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,10" Margin="0,0,0,6"
                                                        CornerRadius="8" Background="#13FFFFFF">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold" FontSize="14"/>
                                                                <!-- بادجات الباقة -->
                                                                <ItemsControl ItemsSource="{Binding PlanBadges}"
                                                                              Margin="10,0,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border CornerRadius="4" Padding="5,2"
                                                                                    Margin="0,0,4,0"
                                                                                    Background="#1E3A5F">
                                                                                <TextBlock Text="{Binding}"
                                                                                           FontSize="10"
                                                                                           Foreground="#93C5FD"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                                         IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                         Click="Toggle_Click" Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="lblHint" Text="اختر شركة لعرض مميزاتها."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="15"/>
            </Grid>
        </Border>
    </Grid>
</Page>
