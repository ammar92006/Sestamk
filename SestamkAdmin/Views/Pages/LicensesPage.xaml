<Page x:Class="SestamkAdmin.Views.Pages.LicensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="التراخيص">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- رأس الصفحة -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Key24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="التراخيص والتفعيل" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="توليد السيريالات وإدارة الاشتراكات والتجديد والإيقاف"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>
            <ui:Button Content="ترخيص جديد" Icon="{ui:SymbolIcon AddCircle24}" Appearance="Primary"
                       Height="42" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Click="NewLicense_Click" />
        </Grid>

        <!-- أدوات: بحث + تحديث -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <ui:TextBox x:Name="txtSearch" PlaceholderText="ابحث بالسيريال أو اسم الشركة..."
                        Icon="{ui:SymbolIcon Search24}" Width="380" HorizontalAlignment="Right"
                        TextChanged="Search_TextChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="lblCount" Text="" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary"
                           Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- الجدول -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#13FFFFFF"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#22FFFFFF"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          Foreground="White" FontSize="13" RowHeight="52"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="السيريال" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding SerialKey}" FontFamily="Consolas"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <ui:Button Icon="{ui:SymbolIcon Copy24}" Appearance="Transparent"
                                                   Padding="4" Margin="6,0,0,0" ToolTip="نسخ"
                                                   Click="Copy_Click" Tag="{Binding SerialKey}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="الباقة" Binding="{Binding PlanDisplay}" Width="90" />

                        <DataGridTemplateColumn Header="الحالة" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,4" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Margin="8,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding StatusColor}" Opacity="0.18" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding StatusColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ينتهي في" Binding="{Binding ExpiresAt}" Width="110" />
                        <DataGridTextColumn Header="الحدود" Binding="{Binding Limits}" Width="190" />

                        <DataGridTemplateColumn Header="إجراءات" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <ui:Button Icon="{ui:SymbolIcon History24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="سجل الترخيص" Margin="0,0,4,0"
                                                   Click="History_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon CalendarClock24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="تجديد" Margin="0,0,4,0"
                                                   Click="Renew_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon PauseCircle24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="إيقاف/تفعيل" Margin="0,0,4,0"
                                                   Click="Suspend_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="حذف"
                                                   Click="Delete_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="lblEmpty" Text="لا توجد تراخيص بعد. اضغط «ترخيص جديد» للبدء."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
