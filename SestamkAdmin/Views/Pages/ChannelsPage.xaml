<Page x:Class="SestamkAdmin.Views.Pages.ChannelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="قنوات التحديث">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- هيدر -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ChannelShare24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="قنوات التحديث" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="إدارة قنوات الإصدارات (public / stable / beta / vip / مخصص)"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            </StackPanel>
            <ui:Button Content="قناة جديدة" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                       Height="42" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Click="New_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14" HorizontalAlignment="Left">
            <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary" Click="Refresh_Click"/>
        </StackPanel>

        <!-- بطاقات القنوات -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="channelsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- اسم + حالة -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding StatusColor}" Opacity="0.18"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding ChannelName}" FontSize="20"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- وصف -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                               FontSize="13" Margin="0,0,0,16"/>

                                    <!-- أزرار -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="تعديل"
                                                   Appearance="Secondary" Padding="10,6"
                                                   Margin="0,0,8,0" Click="Edit_Click" Tag="{Binding}"/>
                                        <ui:Button Icon="{ui:SymbolIcon PauseCircle24}"
                                                   Content="{Binding StatusText}"
                                                   Appearance="Secondary" Padding="10,6"
                                                   Margin="0,0,8,0" Click="Toggle_Click" Tag="{Binding}"/>
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary"
                                                   Padding="10,6" ToolTip="حذف القناة"
                                                   Click="Delete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                <TextBlock x:Name="lblEmpty" Text="لا توجد قنوات."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
