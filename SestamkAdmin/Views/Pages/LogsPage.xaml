<Page x:Class="SestamkAdmin.Views.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="السجلات">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="History24" FontSize="26"
                               Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="السجلات والتدقيق" FontSize="26" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="سجل عمليات المشرفين وسجل اتصالات البرامج بالسيرفر"
                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="cmbType" Width="220" Padding="10,6" SelectionChanged="Type_Changed">
                    <ComboBoxItem Content="سجل التدقيق (المشرفون)" Tag="audit" IsSelected="True" />
                    <ComboBoxItem Content="سجل الاتصالات (العملاء)" Tag="sync" />
                </ComboBox>
            </StackPanel>
            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary"
                       HorizontalAlignment="Left" Click="Refresh_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <!-- سجل التدقيق -->
                <DataGrid x:Name="gridAudit" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                          CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الوقت" Binding="{Binding When}" Width="150" />
                        <DataGridTextColumn Header="المشرف" Binding="{Binding ActorName}" Width="130" />
                        <DataGridTextColumn Header="النوع" Binding="{Binding EntityType}" Width="100" />
                        <DataGridTextColumn Header="الإجراء" Binding="{Binding Action}" Width="100" />
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- سجل الاتصالات -->
                <DataGrid x:Name="gridSync" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                          CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الوقت" Binding="{Binding When}" Width="150" />
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="130" />
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90" />
                        <DataGridTextColumn Header="الإصدار" Binding="{Binding Version}" Width="80" />
                        <DataGridTextColumn Header="الرسالة" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="lblEmpty" Text="لا توجد سجلات."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
