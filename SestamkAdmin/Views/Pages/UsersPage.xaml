<Page x:Class="SestamkAdmin.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="المستخدمون">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="People24" FontSize="26"
                               Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="المستخدمون" FontSize="26" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="مستخدمو الشركات العميلة — تفعيل/إيقاف الحسابات"
                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <ui:TextBox x:Name="txtSearch" PlaceholderText="ابحث بالاسم أو الشركة..."
                        Icon="{ui:SymbolIcon Search24}" Width="380" HorizontalAlignment="Right"
                        TextChanged="Search_TextChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                          CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="50">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="140" />
                        <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="الدور" Binding="{Binding RoleDisplay}" Width="90" />
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120" />
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginDisplay}" Width="130" />
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="80" />
                        <DataGridTemplateColumn Header="إجراءات" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Icon="{ui:SymbolIcon PersonProhibited24}" Appearance="Secondary"
                                               Padding="6" ToolTip="تفعيل/إيقاف" Margin="8,0"
                                               Click="Toggle_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="lblEmpty" Text="لا يوجد مستخدمون بعد."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
