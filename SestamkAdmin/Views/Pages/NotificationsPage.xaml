<Page x:Class="SestamkAdmin.Views.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="الإشعارات">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Alert24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="الإشعارات" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="تنبيهات النظام: تراخيص تنتهي، أجهزة محظورة، شركات جديدة"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            </StackPanel>
            <ui:Button Content="تعليم الكل كمقروء" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                       Appearance="Primary" Height="42" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Click="MarkAll_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <ComboBox x:Name="cmbFilter" Width="160" Padding="10,6" SelectionChanged="Filter_Changed" HorizontalAlignment="Right">
                <ComboBoxItem Content="غير المقروءة" Tag="unread" IsSelected="True"/>
                <ComboBoxItem Content="الكل" Tag="all"/>
            </ComboBox>
            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary"
                       Margin="10,0,0,0" Click="Refresh_Click"/>
            <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" Margin="4" CornerRadius="8" Background="#13FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Color}" Opacity="0.18"/>
                                            </Border.Background>
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20">
                                                <ui:SymbolIcon.Foreground>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </ui:SymbolIcon.Foreground>
                                            </ui:SymbolIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"
                                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding When}" Foreground="#64748B"
                                                       FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Icon="{ui:SymbolIcon Checkmark24}" Appearance="Transparent"
                                                       Padding="5" ToolTip="تعليم كمقروء" Margin="0,0,4,0"
                                                       Click="MarkRead_Click" Tag="{Binding}"/>
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                       Padding="5" ToolTip="حذف"
                                                       Click="Delete_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel x:Name="emptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48"
                                   Foreground="{StaticResource BrandSuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="لا توجد إشعارات 🎉" Style="{StaticResource MutedText}"
                               Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
