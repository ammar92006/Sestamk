<Page x:Class="SestamkAdmin.Views.Pages.AdminUsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="المشرفون">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="المشرفون" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="حسابات المشرفين ولوحة التحكم — الأدوار والصلاحيات"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            </StackPanel>
            <ui:Button Content="مشرف جديد" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Primary"
                       Height="42" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Click="New_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14" HorizontalAlignment="Left">
            <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary" Click="Refresh_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#13FFFFFF"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#22FFFFFF"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          Foreground="White" FontSize="13" RowHeight="54">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="المشرف" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource BrandGradientBrush}">
                                            <TextBlock Text="{Binding AvatarLetter}" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Username}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="البريد" Binding="{Binding Email}" Width="200"/>
                        <DataGridTemplateColumn Header="الدور" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="8,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding RoleColor}" Opacity="0.18"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding RoleDisplay}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding RoleColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginDisplay}" Width="140"/>
                        <DataGridTemplateColumn Header="الحالة" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="8,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding StatusColor}" Opacity="0.18"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding StatusColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <ui:Button Icon="{ui:SymbolIcon Key24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="تغيير كلمة المرور"
                                                   Margin="0,0,4,0" Click="ChangePass_Click" Tag="{Binding}"/>
                                        <ui:Button Icon="{ui:SymbolIcon PersonSwap24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="تغيير الدور"
                                                   Margin="0,0,4,0" Click="ChangeRole_Click" Tag="{Binding}"/>
                                        <ui:Button Icon="{ui:SymbolIcon PersonProhibited24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="تفعيل/إيقاف"
                                                   Click="Toggle_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>
