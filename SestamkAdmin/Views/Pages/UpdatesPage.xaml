<Page x:Class="SestamkAdmin.Views.Pages.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="التحديثات">

    <Grid Margin="24,72,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <!-- يسار: نموذج النشر -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="نشر تحديث" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="بناء ورفع إصدار جديد على GitHub وتسجيله للعملاء"
                           Style="{StaticResource MutedText}" Margin="0,6,0,16" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الإصدار الجديد" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="txtVersion" PlaceholderText="1.1.4" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الإصدار السابق" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="txtPrevVersion" PlaceholderText="1.1.3" Padding="10,8" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="القناة" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <ComboBox x:Name="cmbChannel" Padding="10,8" FontSize="14" />

                    <ui:ToggleSwitch x:Name="swMandatory" Content="تحديث إجباري" Margin="0,16,0,0" />

                    <TextBlock Text="الجديد في هذا الإصدار (سطر لكل بند)" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <ui:TextBox x:Name="txtWhatsNew" AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="110" VerticalContentAlignment="Top" Padding="10,8"
                                PlaceholderText="إصلاح مشكلة...&#x0a;تحسين الأداء..." />

                    <Border Background="#13FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="مجلد البناء (build):" Style="{StaticResource MutedText}" FontSize="12" />
                            <TextBlock x:Name="lblBuildPath" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="btnPublish" Content="نشر التحديث الآن"
                               Icon="{ui:SymbolIcon Rocket24}" Appearance="Primary"
                               HorizontalAlignment="Stretch" Height="46" Margin="0,18,0,0"
                               Click="Publish_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- يمين: سجل النشر + سجل الإصدارات -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- سجل العملية -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,52,0,0" MaxHeight="200">
                <StackPanel>
                    <TextBlock Text="سجل العملية" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <ScrollViewer x:Name="logScroll" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtLog" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" Foreground="#A7F3D0"
                                   Text="جاهز للنشر..." />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,18,0,10">
                <TextBlock Text="سجل الإصدارات" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary"
                           HorizontalAlignment="Right" Click="Refresh_Click" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                              AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                              CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الإصدار" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="القناة" Binding="{Binding ChannelDisplay}" Width="80" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding ReleaseDate}" Width="110" />
                            <DataGridTextColumn Header="الحجم" Binding="{Binding SizeDisplay}" Width="80" />
                            <DataGridTextColumn Header="النوع" Binding="{Binding MandatoryText}" Width="80" />
                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="8,0" Cursor="Hand"
                                                MouseLeftButtonUp="ToggleActive">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding StatusColor}" Opacity="0.18" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding StatusColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="32" Height="32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
