<Page x:Class="SestamkAdmin.Views.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="الأجهزة">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="الأجهزة" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="الأجهزة المرتبطة بكل شركة عبر HWID — حظر، فك حظر، فك ربط"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <ui:TextBox x:Name="txtSearch" PlaceholderText="ابحث بالـ HWID أو الشركة..."
                        Icon="{ui:SymbolIcon Search24}" Width="380" HorizontalAlignment="Right"
                        TextChanged="Search_TextChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                          CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="50">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="HWID" Width="215">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Border Background="#16233A" CornerRadius="6" Padding="9,4"
                                                BorderBrush="#2A3447" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Key24" FontSize="13"
                                                               Foreground="{StaticResource BrandPrimaryBrush}"
                                                               Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ShortHwid}" FontFamily="Consolas"
                                                           FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ui:Button Icon="{ui:SymbolIcon Copy24}" Appearance="Transparent"
                                                   Padding="5" Margin="4,0,0,0" ToolTip="نسخ الـ HWID كاملاً"
                                                   Click="CopyHwid_Click" Tag="{Binding Hwid}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceName}" Width="130" />
                        <DataGridTextColumn Header="المواصفات" Binding="{Binding Specs}" Width="180" />
                        <DataGridTextColumn Header="الإصدار" Binding="{Binding AppVersion}" Width="70" />
                        <DataGridTextColumn Header="آخر ظهور" Binding="{Binding LastSeenDisplay}" Width="130" />
                        <DataGridTemplateColumn Header="الحالة" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="8,0">
                                        <Border.Background><SolidColorBrush Color="{Binding StatusColor}" Opacity="0.18" /></Border.Background>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}" /></TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <ui:Button Icon="{ui:SymbolIcon LockClosed24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="حظر/فك حظر" Margin="0,0,4,0"
                                                   Click="Block_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon PlugDisconnected24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="فك ربط (حذف)" Click="Delete_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="lblEmpty" Text="لا توجد أجهزة مسجّلة بعد."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
