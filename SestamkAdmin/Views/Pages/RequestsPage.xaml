<Page x:Class="SestamkAdmin.Views.Pages.RequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="الطلبات">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="MailInbox24" FontSize="26"
                               Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="الطلبات" FontSize="26" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="طلبات العملاء الواردة — قبول أو رفض مع ملاحظات"
                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="عرض:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}" />
                <ComboBox x:Name="cmbFilter" Width="160" Padding="10,6" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="المعلّقة" Tag="pending" IsSelected="True" />
                    <ComboBoxItem Content="الكل" Tag="all" />
                    <ComboBoxItem Content="المقبولة" Tag="approved" />
                    <ComboBoxItem Content="المرفوضة" Tag="rejected" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                          CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="120" />
                        <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="2*" />
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDisplay}" Width="130" />
                        <DataGridTemplateColumn Header="الحالة" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="8,0">
                                        <Border.Background><SolidColorBrush Color="{Binding StatusColor}" Opacity="0.18" /></Border.Background>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}" /></TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <ui:Button Icon="{ui:SymbolIcon Checkmark24}" Appearance="Success"
                                                   Padding="6" ToolTip="قبول" Margin="0,0,4,0"
                                                   Click="Approve_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Danger"
                                                   Padding="6" ToolTip="رفض" Click="Reject_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="lblEmpty" Text="لا توجد طلبات."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
