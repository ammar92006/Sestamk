<Page x:Class="SestamkAdmin.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="الرئيسية">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,72,24,24">
        <StackPanel>

            <!-- ترحيب -->
            <TextBlock x:Name="lblWelcome" Text="أهلاً بك 👋" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="نظرة عامة على حالة المنظومة الآن"
                       Style="{StaticResource MutedText}" Margin="0,4,0,24" />

            <!-- بطاقات الإحصائيات -->
            <UniformGrid Rows="2" Columns="3">
                <!-- الشركات -->
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#1E3A8A">
                                <ui:SymbolIcon Symbol="Building24" FontSize="22" Foreground="#93C5FD" />
                            </Border>
                            <TextBlock Text="الشركات" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource MutedText}" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="statCompanies" Text="—" FontSize="34" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="statCompaniesSub" Text="إجمالي العملاء" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- التراخيص النشطة -->
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#064E3B">
                                <ui:SymbolIcon Symbol="Key24" FontSize="22" Foreground="#6EE7B7" />
                            </Border>
                            <TextBlock Text="التراخيص النشطة" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource MutedText}" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="statLicenses" Text="—" FontSize="34" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="statLicensesSub" Text="اشتراك فعّال" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- الأجهزة -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#4C1D95">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="22" Foreground="#C4B5FD" />
                            </Border>
                            <TextBlock Text="الأجهزة" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource MutedText}" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="statDevices" Text="—" FontSize="34" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="statDevicesSub" Text="جهاز مسجّل" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- الطلبات المعلّقة -->
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#78350F">
                                <ui:SymbolIcon Symbol="MailInbox24" FontSize="22" Foreground="#FCD34D" />
                            </Border>
                            <TextBlock Text="طلبات معلّقة" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource MutedText}" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="statRequests" Text="—" FontSize="34" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="statRequestsSub" Text="بانتظار الرد" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- الإيرادات -->
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#134E4A">
                                <ui:SymbolIcon Symbol="Money24" FontSize="22" Foreground="#5EEAD4" />
                            </Border>
                            <TextBlock Text="الإيرادات" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource MutedText}" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="statRevenue" Text="—" FontSize="34" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="statRevenueSub" Text="إجمالي قيمة التراخيص" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- تنتهي قريباً -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#7F1D1D">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="22" Foreground="#FCA5A5" />
                            </Border>
                            <TextBlock Text="تنتهي قريباً" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource MutedText}" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="statExpiring" Text="—" FontSize="34" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="statExpiringSub" Text="خلال 7 أيام" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- إجراءات سريعة -->
            <TextBlock Text="إجراءات سريعة" Style="{StaticResource SectionTitle}" Margin="0,32,0,12" />
            <WrapPanel>
                <ui:Button Content="إنشاء ترخيص جديد" Icon="{ui:SymbolIcon AddCircle24}"
                           Appearance="Primary" Height="44" Margin="0,0,12,12" Click="QuickNewLicense_Click" />
                <ui:Button Content="إضافة شركة" Icon="{ui:SymbolIcon BuildingMultiple24}"
                           Height="44" Margin="0,0,12,12" Click="QuickNewCompany_Click" />
                <ui:Button Content="نشر تحديث" Icon="{ui:SymbolIcon CloudArrowUp24}"
                           Height="44" Margin="0,0,12,12" Click="QuickPublish_Click" />
                <ui:Button Content="مراجعة الطلبات" Icon="{ui:SymbolIcon MailInbox24}"
                           Height="44" Margin="0,0,12,12" Click="QuickRequests_Click" />
            </WrapPanel>

            <!-- آخر نشاط -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="آخر نشاط على المنظومة" Style="{StaticResource SectionTitle}" Margin="0" />
                        <ui:Button Content="تحديث" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                                   HorizontalAlignment="Right" Padding="10,4" Click="Refresh_Click" />
                    </Grid>
                    <ui:ProgressRing x:Name="loadingActivity" IsIndeterminate="True"
                                     Width="28" Height="28" Margin="0,16" HorizontalAlignment="Center"
                                     Visibility="Collapsed" />
                    <ItemsControl x:Name="activityList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                Background="{StaticResource BrandPrimaryBrush}"
                                                VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding When}"
                                                   Style="{StaticResource MutedText}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="lblNoActivity" Text="لا يوجد نشاط حتى الآن."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,16" Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
