<Page x:Class="SestamkAdmin.Views.Pages.CompaniesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource AppFontFamily}"
      Foreground="White"
      Title="الشركات">

    <Grid Margin="24,72,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Building24" FontSize="26"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="الشركات" FontSize="26" FontWeight="Bold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="إدارة العملاء — إضافة، تعديل، إيقاف وتجديد العقود"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>
            <ui:Button Content="شركة جديدة" Icon="{ui:SymbolIcon BuildingMultiple24}" Appearance="Primary"
                       Height="42" HorizontalAlignment="Right" VerticalAlignment="Top" Click="New_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <ui:TextBox x:Name="txtSearch" PlaceholderText="ابحث باسم الشركة أو الهاتف..."
                        Icon="{ui:SymbolIcon Search24}" Width="380" HorizontalAlignment="Right"
                        TextChanged="Search_TextChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="lblCount" Text="" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="تحديث" Appearance="Secondary"
                           Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#13FFFFFF" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22FFFFFF" HeadersVisibility="Column"
                          CanUserAddRows="False" Foreground="White" FontSize="13" RowHeight="50">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الشركة" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140" />
                        <DataGridTextColumn Header="المدينة" Binding="{Binding City}" Width="110" />
                        <DataGridTextColumn Header="القناة" Binding="{Binding UpdateChannel}" Width="90" />
                        <DataGridTextColumn Header="نهاية العقد" Binding="{Binding ContractEnd}" Width="110" />
                        <DataGridTemplateColumn Header="الحالة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="8,0"
                                            Background="#22FFFFFF">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="تعديل" Margin="0,0,4,0"
                                                   Click="Edit_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon PauseCircle24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="إيقاف/تفعيل" Margin="0,0,4,0"
                                                   Click="Suspend_Click" Tag="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary"
                                                   Padding="6" ToolTip="حذف"
                                                   Click="Delete_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="36" Height="36"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="lblEmpty" Text="لا توجد شركات بعد. اضغط «شركة جديدة» للبدء."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
