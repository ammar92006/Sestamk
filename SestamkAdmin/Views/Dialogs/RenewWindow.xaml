<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.RenewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="تجديد الترخيص"
                 Width="440" Height="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FlowDirection="RightToLeft"
                 FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White"
                 Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="تجديد الترخيص" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,12,28,8">
            <TextBlock x:Name="lblSerial" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="lblCurrent" Style="{StaticResource MutedText}" Margin="0,4,0,18" />

            <TextBlock Text="مدة التجديد" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="cmbDuration" Padding="10,8" FontSize="14" SelectionChanged="Changed">
                <ComboBoxItem Content="شهر" Tag="1" />
                <ComboBoxItem Content="3 شهور" Tag="3" />
                <ComboBoxItem Content="6 شهور" Tag="6" />
                <ComboBoxItem Content="سنة" Tag="12" IsSelected="True" />
                <ComboBoxItem Content="سنتان" Tag="24" />
            </ComboBox>

            <Border Style="{StaticResource Card}" Padding="12,12" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="تاريخ الانتهاء الجديد" Style="{StaticResource MutedText}" FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="lblNew" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إلغاء" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Cancel_Click" />
                <ui:Button Content="تجديد" Icon="{ui:SymbolIcon CalendarClock24}" Appearance="Primary"
                           Height="42" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
