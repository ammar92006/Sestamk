<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.AdminUserEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="مشرف جديد" Width="480" Height="520"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="مشرف جديد" ShowMaximize="False" ShowMinimize="False"/>
        <ScrollViewer Grid.Row="1" Padding="28,12,28,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="الاسم الكامل" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="txtFullName" PlaceholderText="الاسم الكامل" Padding="10,8"/>

                <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ui:TextBox x:Name="txtUsername" PlaceholderText="username" Padding="10,8" FontFamily="Consolas"/>

                <TextBlock Text="البريد الإلكتروني" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ui:TextBox x:Name="txtEmail" PlaceholderText="email@domain.com" Padding="10,8"/>

                <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ui:PasswordBox x:Name="txtPassword" Padding="10,8"/>

                <TextBlock Text="الدور" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ComboBox x:Name="cmbRole" Padding="10,8" FontSize="14">
                    <ComboBoxItem Content="مشرف (admin)" Tag="admin" IsSelected="True"/>
                    <ComboBoxItem Content="دعم فني (support)" Tag="support"/>
                    <ComboBoxItem Content="مالك (super_admin)" Tag="super_admin"/>
                </ComboBox>

                <TextBlock x:Name="lblError" Foreground="{StaticResource BrandDangerBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إلغاء" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
                <ui:Button x:Name="btnSave" Content="إنشاء الحساب" Icon="{ui:SymbolIcon PersonAdd24}"
                           Appearance="Primary" Height="42" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
