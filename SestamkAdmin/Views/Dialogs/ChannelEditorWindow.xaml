<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.ChannelEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="قناة" Width="440" Height="340"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="titleBar" Grid.Row="0" Title="قناة جديدة" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="28,16,28,8">
            <TextBlock Text="اسم القناة (بالإنجليزي — كلمة واحدة صغيرة)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ui:TextBox x:Name="txtName" PlaceholderText="مثال: enterprise" Padding="10,8" FontFamily="Consolas"/>
            <TextBlock Text="الوصف" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <ui:TextBox x:Name="txtDesc" PlaceholderText="وصف مختصر للقناة..." Padding="10,8"/>
            <TextBlock x:Name="lblError" Foreground="{StaticResource BrandDangerBrush}"
                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إلغاء" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
                <ui:Button x:Name="btnSave" Content="حفظ" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary" Height="42" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
