<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.ListPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="اختيار" Width="400" Height="320"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="titleBar" Grid.Row="0" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="28,16,28,8">
            <TextBlock x:Name="lblMessage" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <ListBox x:Name="listBox" Background="#16233A" BorderBrush="#2A3447"
                     BorderThickness="1" Padding="4" MaxHeight="160"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إلغاء" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
                <ui:Button Content="تأكيد" Appearance="Primary" Height="42" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
