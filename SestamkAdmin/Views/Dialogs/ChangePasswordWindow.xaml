<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.ChangePasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="تغيير كلمة المرور" Width="420" Height="360"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="تغيير كلمة المرور" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="28,16,28,8">
            <TextBlock x:Name="lblFor" Text="" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <TextBlock Text="كلمة المرور الحالية" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ui:PasswordBox x:Name="txtOld" Padding="10,8"/>
            <TextBlock Text="كلمة المرور الجديدة" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <ui:PasswordBox x:Name="txtNew" Padding="10,8"/>
            <TextBlock x:Name="lblError" Foreground="{StaticResource BrandDangerBrush}"
                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="lblSuccess" Text="✓ تم تغيير كلمة المرور بنجاح"
                       Foreground="{StaticResource BrandSuccessBrush}"
                       Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إغلاق" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Close_Click"/>
                <ui:Button x:Name="btnSave" Content="تغيير" Icon="{ui:SymbolIcon Key24}"
                           Appearance="Primary" Height="42" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
