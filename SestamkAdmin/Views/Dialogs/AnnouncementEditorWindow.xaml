<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.AnnouncementEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="إعلان جديد" Width="500" Height="560"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="إعلان جديد" ShowMaximize="False" ShowMinimize="False"/>
        <ScrollViewer Grid.Row="1" Padding="28,12,28,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="العنوان *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="txtTitle" Padding="10,8"/>
                <TextBlock Text="النص *" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ui:TextBox x:Name="txtBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                            VerticalContentAlignment="Top" Padding="10,8"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="القناة المستهدفة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbChannel" Padding="10,8" FontSize="14">
                            <ComboBoxItem Content="كل القنوات" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="public" Tag="public"/>
                            <ComboBoxItem Content="stable" Tag="stable"/>
                            <ComboBoxItem Content="beta" Tag="beta"/>
                            <ComboBoxItem Content="vip" Tag="vip"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ينتهي في (اختياري)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DatePicker x:Name="dpUntil" Padding="6" FontSize="14"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="lblError" Foreground="{StaticResource BrandDangerBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إلغاء" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
                <ui:Button x:Name="btnSave" Content="نشر الإعلان" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Height="42" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
