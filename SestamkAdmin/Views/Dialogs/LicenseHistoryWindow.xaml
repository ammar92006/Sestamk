<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.LicenseHistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="سجل الترخيص" Width="560" Height="560"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="سجل الترخيص" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="24,8,24,12">
            <TextBlock x:Name="lblSerial" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource BrandPrimaryBrush}"/>
            <TextBlock Text="كل العمليات التي تمّت على هذا الترخيص" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0,24,24" Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="2" CornerRadius="8" Background="#13FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="6" Padding="9,3" VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding ActionColor}" Opacity="0.18"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding ActionText}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Foreground><SolidColorBrush Color="{Binding ActionColor}"/></TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Margin="12,0"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="#64748B"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Width="32" Height="32"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblEmpty" Text="لا يوجد سجل لهذا الترخيص."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
