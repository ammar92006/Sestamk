<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.CompanyEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="شركة"
                 Width="560" Height="740"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FlowDirection="RightToLeft"
                 FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White"
                 Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="titleBar" Grid.Row="0" Title="شركة جديدة" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,16,28,8">
            <StackPanel>
                <TextBlock Text="اسم الشركة *" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ui:TextBox x:Name="txtName" Padding="10,8" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الهاتف" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="txtPhone" Padding="10,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="البريد الإلكتروني" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="txtEmail" Padding="10,8" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="المدينة" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="txtCity" Padding="10,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="اسم المسؤول" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="txtContact" Padding="10,8" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="قناة التحديث" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="cmbChannel" Padding="10,8" FontSize="14">
                            <ComboBoxItem Content="public" IsSelected="True" />
                            <ComboBoxItem Content="stable" />
                            <ComboBoxItem Content="beta" />
                            <ComboBoxItem Content="vip" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="مستوى الدعم" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="cmbSupport" Padding="10,8" FontSize="14">
                            <ComboBoxItem Content="basic" IsSelected="True" />
                            <ComboBoxItem Content="priority" />
                            <ComboBoxItem Content="dedicated" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="بداية العقد" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DatePicker x:Name="dpStart" Padding="6" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="نهاية العقد" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DatePicker x:Name="dpEnd" Padding="6" FontSize="14" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ملاحظات" FontWeight="SemiBold" Margin="0,16,0,6" />
                <ui:TextBox x:Name="txtNotes" AcceptsReturn="True" TextWrapping="Wrap"
                            MinHeight="70" VerticalContentAlignment="Top" Padding="10,8" />

                <TextBlock x:Name="lblError" Foreground="{StaticResource BrandDangerBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="إلغاء" Appearance="Secondary" Height="42" Margin="0,0,10,0" Click="Cancel_Click" />
                <ui:Button x:Name="btnSave" Content="حفظ" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary" Height="42" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
