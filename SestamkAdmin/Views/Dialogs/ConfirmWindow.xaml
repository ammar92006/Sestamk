<ui:FluentWindow x:Class="SestamkAdmin.Views.Dialogs.ConfirmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="تأكيد"
                 Width="440" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FlowDirection="RightToLeft"
                 FontFamily="{StaticResource AppFontFamily}"
                 Foreground="White"
                 Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="titleBar" Grid.Row="0" Title="تأكيد" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,20">
            <Border x:Name="iconCircle" Width="56" Height="56" CornerRadius="28"
                    HorizontalAlignment="Right" Background="#26F59E0B">
                <ui:SymbolIcon x:Name="icon" Symbol="Warning24" FontSize="28"
                               Foreground="{StaticResource BrandWarningBrush}" />
            </Border>

            <TextBlock x:Name="lblTitle" Text="" FontSize="18" FontWeight="SemiBold"
                       Margin="0,16,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="lblMessage" Text="" FontSize="14" Margin="0,8,0,0"
                       Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="22" />
        </StackPanel>

        <Border Grid.Row="2" Background="#0E1626" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button x:Name="btnCancel" Content="إلغاء" Appearance="Secondary"
                           Height="42" MinWidth="100" Margin="0,0,10,0" Click="Cancel_Click" />
                <ui:Button x:Name="btnConfirm" Content="تأكيد" Appearance="Primary"
                           Height="42" MinWidth="110" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
